---
import Navigation from "@components/Navigation.astro";
import Filters from "@components/Filters.astro";
import Footer from "@components/Footer.astro";
import getMetaTags from "@modules/getMetaTags";
import { getCanonicalUrl } from "@modules/canonical";
import validateZoom, { defaultZoom } from "@modules/zoom";
import validateTheme, { defaultTheme } from "@modules/theme";
import { SITE_NAME, isIndexable, websiteJsonLd } from "@modules/seo";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  filters?: boolean;
  article?: {
    author?: string;
    score?: number;
    comments?: number;
  };
}

const { filters = false, article } = Astro.props;
const { title, description } = getMetaTags(Astro.props.title, Astro.props.description);
const indexable = isIndexable(Astro.url);
const isHome = Astro.url.pathname === "/" && indexable;

const canonicalUrl = getCanonicalUrl(Astro.url);

const ogImageParams = new URLSearchParams();
ogImageParams.set("title", Astro.props.title ?? "Hacker News");
if (article?.author) ogImageParams.set("author", article.author);
if (article?.score !== undefined) ogImageParams.set("score", String(article.score));
if (article?.comments !== undefined) ogImageParams.set("comments", String(article.comments));
const ogImageUrl = new URL(`/api/og?${ogImageParams.toString()}`, Astro.url.origin).toString();

const theme = validateTheme(Astro.cookies.get("theme")?.value);
const themeClass = theme === defaultTheme ? "" : theme;

const zoom = validateZoom(Astro.cookies.get("zoom")?.value);
const zoomStyle = zoom === defaultZoom ? undefined : `font-size: ${zoom}%;`;
---

<!doctype html>
<html lang="en" class={themeClass} style={zoomStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    {isHome && <script type="application/ld+json" set:html={websiteJsonLd} />}
    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-w-fold bg-gray-100 text-neutral-900 dark:bg-neutral-900 dark:text-white">
    <Navigation />
    {
      article ? (
        <div class="px-3 py-6">
          <slot />
        </div>
      ) : (
        <main class="m-auto flex w-full max-w-screen-md flex-col gap-3 border-gray-200 p-3 dark:border-neutral-500/40 md:border-x">
          {filters && <Filters />}
          <slot />
        </main>
      )
    }
    <Footer />
  </body>
</html>
