---
import Layout from "@layouts/Layout.astro";
import ItemPreview from "@components/ItemPreview.astro";
import Pagination from "@components/Pagination.astro";
import loadListing from "@modules/listing";
import { applyEdgeCache } from "@modules/cache";
import { getListingTitle } from "@modules/seo";
import { getBookmarkedIds } from "@modules/bookmarks";

const listing = await loadListing(Astro, "/ask", "askstories");
if (listing instanceof Response) return listing;
const { page, totalPages, posts, baseUrl } = listing;

const bookmarkedIds = getBookmarkedIds(Astro.cookies);

applyEdgeCache(Astro.cookies, Astro.response, 60);
---

<Layout filters title={getListingTitle("Ask HN", Astro.url)} description="Ask HN: questions and discussions from the Hacker News community.">
  <Pagination currentPage={page} totalPages={totalPages} baseUrl={baseUrl} />
  <div class="flex flex-col gap-3">
    {posts.map((post) => <ItemPreview data={post} bookmarkedIds={bookmarkedIds} />)}
  </div>
  <Pagination currentPage={page} totalPages={totalPages} baseUrl={baseUrl} />
</Layout>
